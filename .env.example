# ── Ambiente ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Banco de Dados ────────────────────────────────────────────────────────────
# Deixe em branco para usar o caminho padrão: ./data/cleanxhedule.db
DB_PATH=

# ── JWT ───────────────────────────────────────────────────────────────────────
# IMPORTANTE: Substitua por strings aleatórias longas em produção!
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_in_production_use_long_random_string_here
JWT_REFRESH_SECRET=change_me_refresh_use_different_long_random_string

JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
